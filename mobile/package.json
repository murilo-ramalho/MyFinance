{
  "name": "myfinance-mobile-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.mjs start",
    "android": "node scripts/expo.mjs start --android",
    "web": "node scripts/expo.mjs start --web",
    "bundle:android": "node scripts/expo.mjs export --platform android --output-dir dist",
    "bundle:web": "node scripts/expo.mjs export --platform web --output-dir web-build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types tests/run.ts",
    "test:ui": "jest --config jest.config.cjs --runInBand",
    "test:e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
